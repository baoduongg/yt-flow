# Gemini (text metadata gen only — video now generated via Playwright + gemini.google.com, see lib/gemini-browser.ts)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Gemini browser automation (optional override)
# GEMINI_PROFILE_DIR=.gemini-profile

# YouTube Data API v3 (OAuth2 refresh token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | private | unlisted — defaults to "private" in code if unset
YOUTUBE_PRIVACY_STATUS=private

# Telegram bot (scripts/telegram-bot.ts) — control the pipeline remotely
TELEGRAM_BOT_TOKEN=
# chat/user id allowed to issue commands — everyone else is silently ignored
TELEGRAM_CHAT_ID=

# Web dashboard (scripts/web-server.ts) — port to bind on localhost, default 3000
# WEB_PORT=3000

